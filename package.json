{
  "name": "POS",
  "productName": "POS",
  "version": "1.0.0",
  "description": "Store Point of Sale System - Kenyan Shillings (KSh)",
  "author": "Hosting Domain",
  "license": "MIT",
  "private": true,
  "main": "start.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron start.js",
    "pack": "electron-builder --dir --win --x64 --publish never",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:all": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.storepos.ke",
    "productName": "POS",
    "copyright": "Copyright (c) Store POS",
    "asar": false,
    "directories": {
      "output": "release-builds"
    },
    "files": [
      "start.js",
      "server.js",
      "renderer.js",
      "index.html",
      "package.json",
      "api/**/*",
      "assets/**/*",
      "installers/setupEvents.js",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/images/icon.ico",
      "artifactName": "StorePOS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "POS",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "async": "^2.6.4",
    "body-parser": "^1.18.2",
    "btoa": "^1.2.1",
    "electron-context-menu": "^0.15.1",
    "express": "^4.19.2",
    "express-fileupload": "^1.1.6",
    "html2canvas": "^1.0.0-rc.5",
    "jquery": "^3.4.1",
    "jsbarcode": "^3.11.0",
    "jspdf": "^2.3.1",
    "macaddress": "^0.2.9",
    "moment": "^2.29.4",
    "multer": "^1.4.2",
    "nedb": "^1.8.0",
    "path": "^0.12.7",
    "print-js": "^1.0.63",
    "socket.io": "^2.4.0",
    "sweetalert2": "^9.5.4"
  },
  "devDependencies": {
    "cross-env": "^6.0.3",
    "electron": "^22.0.0",
    "electron-builder": "^21.2.0",
    "electron-is-dev": "^1.1.0",
    "nodemon": "^1.19.3"
  }
}
